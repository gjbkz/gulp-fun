{
    "name": "gulp-fun",
    "version": "1.1.4",
    "description": "Create a transform stream from sync/async function.",
    "author": {
        "name": "Kei Ito",
        "email": "kei.itof@gmail.com",
        "url": "https://github.com/kei-ito"
    },
    "license": "Apache-2.0",
    "engines": {
        "node": ">=12"
    },
    "repository": "kei-ito/gulp-fun",
    "main": "lib/index.js",
    "files": [
        "lib"
    ],
    "scripts": {
        "lint": "biome lint src test",
        "build": "tsc --project tsconfig.build.json",
        "test": "ava",
        "version": "run-s version:changelog version:add",
        "version:changelog": "npx @nlib/changelog --output CHANGELOG.md",
        "version:add": "git add ."
    },
    "peerDependencies": {
        "@types/vinyl": "2.0.12"
    },
    "peerDependenciesMeta": {
        "@types/vinyl": {
            "optional": true
        }
    },
    "devDependencies": {
        "@biomejs/biome": "2.6.7",
        "@nlib/githooks": "0.2.2",
        "@types/node": "18.19.130",
        "@types/vinyl-fs": "3.0.8",
        "ava": "5.3.1",
        "lint-staged": "13.3.0",
        "npm-run-all": "4.1.5",
        "rimraf": "3.0.2",
        "ts-node": "10.9.2",
        "typescript": "4.9.5",
        "vinyl-fs": "3.0.3"
    },
    "ava": {
        "extensions": [
            "js",
            "ts"
        ],
        "require": [
            "ts-node/register"
        ],
        "files": [
            "test/**/*.test.ts"
        ]
    },
    "lint-staged": {
        "*!(.d).{ts,tsx,js,mjs,cjs,jsx}": "biome lint --no-errors-on-unmatched"
    },
    "renovate": {
        "extends": [
            "github>nlibjs/renovate-config"
        ]
    }
}

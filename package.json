{
    "name": "gulp-fun",
    "version": "2.0.0",
    "description": "Create a transform stream from sync/async function.",
    "author": {
        "name": "Kei Ito",
        "email": "kei.itof@gmail.com",
        "url": "https://github.com/gjbkz"
    },
    "license": "Apache-2.0",
    "engines": {
        "node": ">=22"
    },
    "repository": "github:gjbkz/gulp-fun",
    "main": "lib/index.js",
    "types": "lib/index.d.ts",
    "files": [
        "lib"
    ],
    "scripts": {
        "build": "node -e \"require('node:fs').rmSync('lib', {recursive: true, force: true})\" && tsc --project tsconfig.build.json",
        "test": "npm run build && node --test test/*.test.cjs",
        "prepack": "npm run build"
    },
    "peerDependencies": {
        "@types/vinyl": "^2.0.7"
    },
    "peerDependenciesMeta": {
        "@types/vinyl": {
            "optional": true
        }
    },
    "devDependencies": {
        "@types/node": "22.20.5",
        "@types/vinyl": "2.0.12",
        "gulp": "5.0.1",
        "typescript": "7.0.2"
    },
    "renovate": {
        "extends": [
            "config:recommended"
        ],
        "dependencyDashboard": false,
        "automerge": false,
        "packageRules": [
            {
                "matchDepTypes": [
                    "devDependencies"
                ],
                "enabled": false
            }
        ]
    }
}
